# Normalize line endings so shell scripts stay LF on checkout.
* text=auto eol=lf

*.sh text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf

# Binary assets must never be normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.tar.gz binary
